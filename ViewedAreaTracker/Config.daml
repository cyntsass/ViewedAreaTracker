<?xml version="1.0" encoding="utf-8" ?>

<ArcGIS defaultAssembly="ViewedAreaTracker.dll"
        defaultNamespace="ViewedAreaTracker"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Users/xsascy/AppData/Local/Programs/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">

	<AddInInfo id="{aeaec78e-910c-4cff-b48e-d4100dd7499f}"
			   version="1.0"
			   desktopVersion="3.6.59527"
			   product="ArcGISPro">

		<Name>ViewedAreaTracker</Name>
		<Description>Records the map areas viewed while navigating in ArcGIS Pro.</Description>
		<Image>Images\AddinDesktop32.png</Image>
		<Author>xsascy</Author>
		<Company>University of Gothenburg</Company>
		<Date>9/16/2026 7:08:47 PM</Date>
		<Subject>Map Exploration</Subject>

	</AddInInfo>

	<modules>

		<insertModule id="ViewedAreaTracker_Module"
					  className="Module1"
					  autoLoad="false"
					  caption="Viewed Area Tracker">

			<tabs>
			</tabs>

			<groups>

				<group id="ViewedAreaTracker_Group1"
					   caption="Viewed Area Tracker"
					   appearsOnAddInTab="true">

					<button refID="ViewedAreaTracker_StartTrackingButton"/>
					<button refID="ViewedAreaTracker_StopTrackingButton"/>
					<comboBox refID="ViewedAreaTracker_ScaleComboBox"/>

				</group>

			</groups>

			<controls>

				<button id="ViewedAreaTracker_StartTrackingButton"
						caption="Start Tracking"
						className="StartTrackingButton"
						loadOnClick="true">

					<tooltip heading="Start tracking">
						Start recording the visible map area while you pan and zoom.
					</tooltip>

				</button>

				<button id="ViewedAreaTracker_StopTrackingButton"
						caption="Stop Tracking"
						className="StopTrackingButton"
						loadOnClick="true">

					<tooltip heading="Stop tracking">
						Stop recording viewed map areas.
					</tooltip>

				</button>

				<comboBox id="ViewedAreaTracker_ScaleComboBox"
						  caption="Maximum Scale"
						  className="ScaleComboBox"
						  loadOnClick="true"
						  width="120">

					<tooltip heading="Maximum recording scale">
						Only record viewed areas when the map is at this scale or closer.
					</tooltip>

				</comboBox>

			</controls>

		</insertModule>

	</modules>

</ArcGIS>